package com.example.app.careerreadiness

enum class ReadinessStatus {
    NOT_ASSESSED,
    NEEDS_FOUNDATION,
    DEVELOPING,
    ALMOST_READY,
    READY
}

data class AssessmentSnapshot(
    val assessmentDate: Long = System.currentTimeMillis(),
    val interestScore: Int = 0,
    val aptitudeScore: Int = 0,
    val skillScore: Int = 0,
    val knowledgeScore: Int = 0,
    val strengths: List<String> = emptyList(),
    val improvementAreas: List<String> = emptyList()
) {
    fun normalized(): AssessmentSnapshot = copy(
        interestScore = interestScore.coerceIn(0, 100),
        aptitudeScore = aptitudeScore.coerceIn(0, 100),
        skillScore = skillScore.coerceIn(0, 100),
        knowledgeScore = knowledgeScore.coerceIn(0, 100)
    )

    val averageScore: Int
        get() {
            val a = normalized()
            return (
                a.interestScore + a.aptitudeScore +
                    a.skillScore + a.knowledgeScore
                ) / 4
        }
}

data class ProjectReadinessInput(
    val totalProjects: Int = 0,
    val completedProjects: Int = 0,
    val completedTasks: Int = 0,
    val totalTasks: Int = 0,
    val averageEvaluationScore: Int = 0,
    val demonstratedSkills: List<String> = emptyList(),
    val improvementSkills: List<String> = emptyList()
)

data class CareerReadinessInput(
    val studentId: String,
    val careerCode: String,
    val careerTitle: String,
    val previousAssessment: AssessmentSnapshot?,
    val currentAssessment: AssessmentSnapshot,
    val currentSkills: List<String>,
    val requiredSkills: List<String>,
    val partialSkills: List<String> = emptyList(),
    val projectProgress: ProjectReadinessInput = ProjectReadinessInput(),
    val educationCompatible: Boolean = false
